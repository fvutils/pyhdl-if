 *
 * Runtime support for generated records and interfaces.
 *
 * Code generated by the gen-from-* commands calls only these functions and
 * the Python C API wrappers in this package. They are a compatibility
 * contract: see PYHDL_IF_RT_API_VERSION.
 *
 * Reference-count conventions, stated per function:
 * - "new ref": the caller owns the result and must Py_DecRef it.
 * - "steals": the function takes ownership of the argument.
 * - "borrowed": the function neither keeps nor releases the argument.
 * Functions marked "GIL held" must be called with the GIL; the others take
 * it themselves.
 */

    /**
     * Number of runtime errors reported by #pyhdl_if_rt_error.
     */
    int pyhdl_if_rt_errors = 0;

    /**
     * SystemVerilog type of a record field that holds bytes.
     */
    typedef byte unsigned pyhdl_if_bytes_t[$];

    /**
     * When set (the default), a runtime error ends the simulation.
     * Clear it to count errors in #pyhdl_if_rt_errors instead.
     */
    bit pyhdl_if_rt_error_fatal = 1;

    PyObject __rt_m;
    PyObject __rt_rec_from_sv;
    PyObject __rt_rec_to_sv;
    PyObject __rt_get_field;
    PyObject __rt_set_field;
    PyObject __rt_sv_obj_new;
    PyObject __rt_sv_obj_id;
    PyObject __rt_py_adapt;
    PyObject __rt_invoke_py_t;
    PyObject __rt_take_released;
    PyObject __rt_error;

    /**
     * Reports an error from generated code or the runtime.
     *
     * Prints the message, counts it, and ends the simulation unless
     * #pyhdl_if_rt_error_fatal is cleared.
     *
     * @param msg What went wrong.
     */
    function automatic void pyhdl_if_rt_error(string msg);
        pyhdl_if_rt_errors++;
        $display("PyHDL-IF Error: %0s", msg);
        if (pyhdl_if_rt_error_fatal) begin
            $finish;
        end
    endfunction

    function automatic PyObject __pyhdl_if_rt_attr(string name);
        PyObject ret = PyObject_GetAttrString(__rt_m, name);
        if (ret == null) begin
            PyErr_Print();
            $display("PyHDL-IF Fatal: hdl_if.rt has no attribute '%0s'", name);
            $finish;
        end
        return ret;
    endfunction

    /**
     * Loads the Python half of the runtime. GIL held. Idempotent.
     */
    function automatic void __pyhdl_if_rt_init();
        if (__rt_m != null) begin
            return;
        end
        __rt_m = PyImport_ImportModule("hdl_if.rt");
        if (__rt_m == null) begin
            PyErr_Print();
            $display("PyHDL-IF Fatal: failed to import hdl_if.rt");
            $finish;
            return;
        end
        __rt_rec_from_sv = __pyhdl_if_rt_attr("rec_from_sv");
        __rt_rec_to_sv = __pyhdl_if_rt_attr("rec_to_sv");
        __rt_get_field = __pyhdl_if_rt_attr("get_field");
        __rt_set_field = __pyhdl_if_rt_attr("set_field");
        __rt_sv_obj_new = __pyhdl_if_rt_attr("sv_obj_new");
        __rt_sv_obj_id = __pyhdl_if_rt_attr("sv_obj_id");
        __rt_py_adapt = __pyhdl_if_rt_attr("py_adapt");
        __rt_invoke_py_t = __pyhdl_if_rt_attr("invoke_py_t");
        __rt_take_released = __pyhdl_if_rt_attr("take_released");
        __rt_error = __pyhdl_if_rt_attr("ERROR");
    endfunction

    /**
     * Returns a new reference to None. GIL held.
     */
    function automatic PyObject pyhdl_if_rt_none();
        Py_IncRef(None);
        return None;
    endfunction

    /**
     * Calls fn(*args), reporting any exception. GIL held.
     *
     * @param fn The callable. Borrowed.
     * @param args Argument tuple. Steals.
     * @param what Names the call, for the error message.
     * @return New ref to the result, or null if the call raised.
     */
    function automatic PyObject pyhdl_if_rt_call(
        PyObject        fn,
        PyObject        args,
        string          what);
        PyObject ret = PyObject_Call(fn, args, null);
        Py_DecRef(args);
        if (ret == null) begin
            PyErr_Print();
            pyhdl_if_rt_error($sformatf("Python exception in %0s", what));
        end
        return ret;
    endfunction

    /**
     * Returns attribute `name` of module `modname`. GIL held.
     *
     * Generated packages use this to find their Python classes. A missing
     * module or attribute is fatal.
     *
     * @return New ref.
     */
    function automatic PyObject pyhdl_if_rt_import(
        string          modname,
        string          name);
        PyObject mod, ret;
        __pyhdl_if_rt_init();
        mod = PyImport_ImportModule(modname);
        if (mod == null) begin
            PyErr_Print();
            $display("PyHDL-IF Fatal: failed to import Python module '%0s'", modname);
            $finish;
            return null;
        end
        ret = PyObject_GetAttrString(mod, name);
        Py_DecRef(mod);
        if (ret == null) begin
            PyErr_Print();
            $display("PyHDL-IF Fatal: Python module '%0s' has no attribute '%0s'", modname, name);
            $finish;
        end
        return ret;
    endfunction

    /**
     * Builds a Python record from its payload. GIL held.
     *
     * @param cls The record's dataclass. Borrowed.
     * @param payload The payload. Steals.
     * @return New ref, or null on error.
     */
    function automatic PyObject pyhdl_if_rt_recFromSv(
        PyObject        cls,
        PyObject        payload);
        PyObject args;
        __pyhdl_if_rt_init();
        args = PyTuple_New(2);
        Py_IncRef(cls);
        void'(PyTuple_SetItem(args, 0, cls));
        void'(PyTuple_SetItem(args, 1, payload));
        return pyhdl_if_rt_call(__rt_rec_from_sv, args, "hdl_if.rt.rec_from_sv");
    endfunction

    /**
     * Returns the payload of a Python record. GIL held.
     *
     * @param obj The record, or a reference to an SV record. Borrowed.
     * @return New ref, or null on error.
     */
    function automatic PyObject pyhdl_if_rt_recToSv(PyObject obj);
        PyObject args;
        __pyhdl_if_rt_init();
        args = PyTuple_New(1);
        Py_IncRef(obj);
        void'(PyTuple_SetItem(args, 0, obj));
        return pyhdl_if_rt_call(__rt_rec_to_sv, args, "hdl_if.rt.rec_to_sv");
    endfunction

    /**
     * Returns the payload of one field of a Python record. GIL held.
     *
     * @param obj The record. Borrowed.
     * @param name Field name.
     * @return New ref, or null on error.
     */
    function automatic PyObject pyhdl_if_rt_getField(
        PyObject        obj,
        string          name);
        PyObject args;
        __pyhdl_if_rt_init();
        args = PyTuple_New(2);
        Py_IncRef(obj);
        void'(PyTuple_SetItem(args, 0, obj));
        void'(PyTuple_SetItem(args, 1, PyUnicode_FromString(name)));
        return pyhdl_if_rt_call(__rt_get_field, args, {"hdl_if.rt.get_field: ", name});
    endfunction

    /**
     * Sets one field of a Python record from its payload. GIL held.
     *
     * @param obj The record. Borrowed.
     * @param name Field name.
     * @param payload The field's payload. Steals.
     */
    function automatic void pyhdl_if_rt_setField(
        PyObject        obj,
        string          name,
        PyObject        payload);
        PyObject args, ret;
        __pyhdl_if_rt_init();
        args = PyTuple_New(3);
        Py_IncRef(obj);
        void'(PyTuple_SetItem(args, 0, obj));
        void'(PyTuple_SetItem(args, 1, PyUnicode_FromString(name)));
        void'(PyTuple_SetItem(args, 2, payload));
        ret = pyhdl_if_rt_call(__rt_set_field, args, {"hdl_if.rt.set_field: ", name});
        if (ret != null) begin
            Py_DecRef(ret);
        end
    endfunction

    /**
     * Returns attribute `name` of `obj`, reporting a missing one. GIL held.
     *
     * @return New ref, or null on error.
     */
    function automatic PyObject pyhdl_if_rt_getAttr(
        PyObject        obj,
        string          name);
        PyObject ret = PyObject_GetAttrString(obj, name);
        if (ret == null) begin
            PyErr_Print();
            pyhdl_if_rt_error({"failed to get Python attribute ", name});
        end
        return ret;
    endfunction

    /**
     * Sets attribute `name` of `obj`. GIL held.
     *
     * @param val New value. Steals.
     */
    function automatic void pyhdl_if_rt_setAttr(
        PyObject        obj,
        string          name,
        PyObject        val);
        if (PyObject_SetAttrString(obj, name, val) != 0) begin
            PyErr_Print();
            pyhdl_if_rt_error({"failed to set Python attribute ", name});
        end
        Py_DecRef(val);
    endfunction

    /**
     * Makes an SV object reachable from Python. GIL held.
     *
     * Registers `adapter` in the object table and creates its Python
     * stand-in. The slot is freed when Python drops the last reference.
     *
     * @param cls Python class of the stand-in (a subclass of
     *        hdl_if.rt.SvObj). Borrowed.
     * @param adapter Receives the calls Python makes on the stand-in.
     * @return New ref.
     */
    function automatic PyObject pyhdl_if_rt_svObjNew(
        PyObject        cls,
        ICallApi        adapter);
        PyObject args;
        int obj_id;
        __pyhdl_if_rt_init();
        obj_id = allocObjId(adapter);
        args = PyTuple_New(2);
        Py_IncRef(cls);
        void'(PyTuple_SetItem(args, 0, cls));
        void'(PyTuple_SetItem(args, 1, PyLong_FromLong(longint'(obj_id))));
        return pyhdl_if_rt_call(__rt_sv_obj_new, args, "hdl_if.rt.sv_obj_new");
    endfunction

    /**
     * Recognizes an SV object coming back from Python. GIL held.
     *
     * @param obj A Python object. Borrowed.
     * @return The adapter registered by #pyhdl_if_rt_svObjNew if `obj` is the
     *         stand-in of an SV object, otherwise null.
     */
    function automatic ICallApi pyhdl_if_rt_svObjGet(PyObject obj);
        PyObject args, id_o;
        longint obj_id;
        __pyhdl_if_rt_init();
        args = PyTuple_New(1);
        Py_IncRef(obj);
        void'(PyTuple_SetItem(args, 0, obj));
        id_o = pyhdl_if_rt_call(__rt_sv_obj_id, args, "hdl_if.rt.sv_obj_id");
        if (id_o == null) begin
            return null;
        end
        obj_id = PyLong_AsLongLong(id_o);
        Py_DecRef(id_o);
        if (obj_id < 0 || obj_id >= __objects.size()) begin
            return null;
        end
        return __objects[obj_id];
    endfunction

    /**
     * Wraps a Python implementation of an interface so SV can call it.
     * GIL held.
     *
     * @param adapter_cls The interface's generated Python adapter class.
     *        Borrowed.
     * @param impl The implementation, or an adapter already. Borrowed.
     * @return New ref to the adapter.
     */
    function automatic PyObject pyhdl_if_rt_pyAdapt(
        PyObject        adapter_cls,
        PyObject        impl);
        PyObject args;
        __pyhdl_if_rt_init();
        args = PyTuple_New(2);
        Py_IncRef(adapter_cls);
        void'(PyTuple_SetItem(args, 0, adapter_cls));
        Py_IncRef(impl);
        void'(PyTuple_SetItem(args, 1, impl));
        return pyhdl_if_rt_call(__rt_py_adapt, args, "hdl_if.rt.py_adapt");
    endfunction

    /**
     * Calls a Python method that does not consume time.
     *
     * @param obj The object. Borrowed.
     * @param method Method name.
     * @param args Argument tuple. Steals.
     * @return New ref to the result, or null if the call raised (reported).
     */
    function automatic PyObject pyhdl_if_rt_callPyFunc(
        PyObject        obj,
        string          method,
        PyObject        args);
        PyObject m, ret;
        PyGILState_STATE state = PyGILState_Ensure();
        m = PyObject_GetAttrString(obj, method);
        if (m == null) begin
            PyErr_Print();
            Py_DecRef(args);
            pyhdl_if_rt_error({"Python object has no method ", method});
            PyGILState_Release(state);
            return null;
        end
        ret = pyhdl_if_rt_call(m, args, method);
        Py_DecRef(m);
        PyGILState_Release(state);
        return ret;
    endfunction

    /**
     * Calls a Python coroutine method and waits for it to complete.
     *
     * @param res New ref to the result, or null if the call raised
     *        (reported).
     * @param obj The object. Borrowed.
     * @param method Method name.
     * @param args Argument tuple. Steals.
     */
    task automatic pyhdl_if_rt_callPyTask(
        output PyObject     res,
        input PyObject      obj,
        input string        method,
        input PyObject      args);
        int sem_id = pyhdl_if_allocSem();
        PyObject targs, ret;
        PyGILState_STATE state = PyGILState_Ensure();

        __pyhdl_if_rt_init();
        __sv2py_call++;

        targs = PyTuple_New(4);
        void'(PyTuple_SetItem(targs, 0, PyLong_FromLong(longint'(sem_id))));
        Py_IncRef(obj);
        void'(PyTuple_SetItem(targs, 1, obj));
        void'(PyTuple_SetItem(targs, 2, PyUnicode_FromString(method)));
        void'(PyTuple_SetItem(targs, 3, args));

        ret = pyhdl_if_rt_call(__rt_invoke_py_t, targs, method);
        if (ret == null) begin
            __callsem_res[sem_id] = null;
            res = null;
        end else begin
            Py_DecRef(ret);
            pyhdl_if_waitSem(sem_id, res, state);
            if (res == __rt_error) begin
                Py_DecRef(res);
                res = null;
                pyhdl_if_rt_error($sformatf("Python exception in %0s", method));
            end
        end

        PyGILState_Release(state);
        __sv2py_resp++;
    endtask

    /**
     * Base of generated SV handles to Python objects: references to Python
     * records and proxies for Python implementations of interfaces.
     *
     * Holds one reference to the Python object until #dispose. A second
     * dispose() does nothing; any other use after dispose() is a runtime
     * error.
     */
    virtual class PyRef;
        PyObject        m_obj;
        protected string m_kind;

        /**
         * @param obj The Python object. Steals the reference.
         * @param kind Names the generated class, for error messages.
         */
        function new(PyObject obj, string kind);
            m_obj = obj;
            m_kind = kind;
        endfunction

        /**
         * Returns 1 if the object is live; otherwise reports use after
         * dispose() and returns 0.
         */
        protected function bit live(string what);
            if (m_obj == null) begin
                pyhdl_if_rt_error({m_kind, ".", what, ": used after dispose()"});
                return 0;
            end
            return 1;
        endfunction

        /**
         * Returns the Python object (borrowed), or null after dispose().
         */
        function PyObject pyobj();
            return m_obj;
        endfunction

        /**
         * Releases the Python object.
         */
        virtual function void dispose();
            if (m_obj != null) begin
                PyGILState_STATE state = PyGILState_Ensure();
                Py_DecRef(m_obj);
                PyGILState_Release(state);
                m_obj = null;
            end
        endfunction
    endclass

    /**
     * Returns a new reference to the Python object behind `r`, or reports
     * use after dispose() and returns None. GIL held.
     */
    function automatic PyObject pyhdl_if_rt_pyRefObj(PyRef r);
        if (r.m_obj == null) begin
            pyhdl_if_rt_error("Python reference used after dispose()");
            return pyhdl_if_rt_none();
        end
        Py_IncRef(r.m_obj);
        return r.m_obj;
    endfunction

    /**
     * Returns the payload for a byte queue. GIL held.
     *
     * Generated code passes byte-queue fields through this and
     * #pyhdl_if_rt_bytesFromPy so the format stays a runtime detail.
     *
     * @return New ref.
     */
    function automatic PyObject pyhdl_if_rt_bytesToPy(pyhdl_if_bytes_t v);
        PyObject ret = PyList_New(64'(v.size()));
        foreach (v[i]) begin
            void'(PyList_SetItem(ret, 64'(i), PyLong_FromLong(64'(v[i]))));
        end
        return ret;
    endfunction

    /**
     * Returns the byte queue for a payload built by the Python counterpart of
     * #pyhdl_if_rt_bytesToPy. GIL held.
     *
     * @param o The payload. Borrowed.
     */
    function automatic pyhdl_if_bytes_t pyhdl_if_rt_bytesFromPy(PyObject o);
        byte unsigned tmp[];
        if (o == null) begin
            return tmp;
        end
        tmp = new[int'(PyList_Size(o))];
        foreach (tmp[i]) begin
            tmp[i] = 8'(PyLong_AsLong(PyList_GetItem(o, 64'(i))));
        end
        return tmp;
    endfunction

    /**
     * Frees an object-table slot.
     *
     * @param id The id from #allocObjId.
     */
    function automatic void pyhdl_if_freeObjId(int id);
        if (id >= 0 && id < __objects.size()) begin
            __objects[id] = null;
        end
    endfunction

    /**
     * Frees the slots of SV objects Python no longer references.
     */
    function automatic void pyhdl_if_rt_reapObjIds();
        PyObject args, ids;
        PyGILState_STATE state = PyGILState_Ensure();
        __pyhdl_if_rt_init();
        args = PyTuple_New(0);
        ids = pyhdl_if_rt_call(__rt_take_released, args, "hdl_if.rt.take_released");
        if (ids != null) begin
            int n = int'(PyList_Size(ids));
            for (int i=0; i<n; i++) begin
                pyhdl_if_freeObjId(int'(PyLong_AsLongLong(PyList_GetItem(ids, 64'(i)))));
            end
            Py_DecRef(ids);
        end
        PyGILState_Release(state);
    endfunction

    /**
     * Returns the number of occupied object-table slots, after reaping.
     */
    function automatic int pyhdl_if_rt_numObjs();
        int ret = 0;
        pyhdl_if_rt_reapObjIds();
        foreach (__objects[i]) begin
            if (__objects[i] != null) begin
                ret++;
            end
        end
        return ret;
    endfunction
