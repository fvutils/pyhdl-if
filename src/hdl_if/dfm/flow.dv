package:
  name: pyhdl-if

  tasks:
  - name: DpiLib
    desc: PyHDL-IF DPI Library
    shell: pytask
    run: hdl_if.dfm.dpi_lib.DpiLib

  - name: VpiLib
    desc: PyHDL-IF VPI Library
    shell: pytask
    run: hdl_if.dfm.vpi_lib.VpiLib
  
  - name: SvPkg
    desc: PyHDL-IF SystemVerilog Package
    shell: pytask
    run: hdl_if.dfm.sv_pkg.SvPkg

  - name: UVMPkg
    desc: PyHDL-IF UVM integration support
    shell: pytask
    run: hdl_if.dfm.uvm_pkg.UVMPkg
    consumes: none
    needs: [SvPkg]

  - name: APIGenSV
    desc: Generates a SystemVerilog API from the Python API
    consumes:
    - { type: std.SetEnv }
    shell: pytask
    run: hdl_if.dfm.api_gen_sv.APIGenSV
    with:
      inline:
        desc: Run the generator in-line 
        type: bool
        value: False
      filename:
        desc: name of the output file
        type: str
      pkgname:
        desc: Of the package
        type: str
        value: ""
      pythonpath:
        desc: Extra PYTHONPATH to use 
        type: list
      modules:
        desc: List of Python modules to load
        type: list
      spec:
        desc: API specification (inline string or filepath)
        type: str
        value: ""
      spec_fmt:
        desc: Format of the spec (json, yaml, toml, or auto-detect)
        type: str
        value: ""
      json_spec:
        desc: (Deprecated) JSON string defining the API classes. Use 'spec' instead
        type: str
        value: ""

  - name: GenFromPy
    desc: Generates SV and Python code for records and interfaces declared in Python
    doc: |
      Runs `pyhdl-if gen-from-py`. Produces the SV package as a
      systemVerilogSource FileSet and a std.Env that puts the generated
      Python module (and `pythonpath`) on PYTHONPATH for the simulation.
    consumes:
    - { type: std.SetEnv }
    shell: pytask
    run: hdl_if.dfm.gen_from.GenFromPy
    with:
      pkgname:
        desc: Name of the SV package; the file is <pkgname>.sv
        type: str
      pymodule:
        desc: Name of the generated Python module (default <pkgname>_api)
        type: str
        value: ""
      modules:
        desc: Python modules to scan
        type: list
      include:
        desc: Only use classes whose module.Class matches one of these patterns
        type: list
      exclude:
        desc: Skip classes whose module.Class matches one of these patterns
        type: list
      pythonpath:
        desc: Directories the modules are imported from (relative to the flow's directory)
        type: list

  - name: GenFromSpec
    desc: Generates SV and Python code for records and interfaces described in a v2 JSON spec
    doc: |
      Runs `pyhdl-if gen-from-spec`. Produces the SV package as a
      systemVerilogSource FileSet and a std.Env that puts the generated
      Python module on PYTHONPATH for the simulation.
    consumes:
    - { type: std.SetEnv }
    shell: pytask
    run: hdl_if.dfm.gen_from.GenFromSpec
    with:
      pkgname:
        desc: Name of the SV package; the file is <pkgname>.sv
        type: str
      pymodule:
        desc: Name of the generated Python module (default <pkgname>_api)
        type: str
        value: ""
      spec:
        desc: Path of the v2 JSON spec (relative to the flow's directory)
        type: str

  - name: GenFromSv
    desc: Generates SV and Python code for records and interfaces declared in SystemVerilog
    doc: |
      Runs `pyhdl-if gen-from-sv` (needs pyslang) over the SV FileSets this
      task needs. Produces the generated SV package as a systemVerilogSource
      FileSet (compile it after the sources it mirrors) and a std.Env that
      puts the generated Python module on PYTHONPATH.
    consumes:
    - filetype: systemVerilogSource
    - filetype: verilogSource
    - filetype: systemVerilogInclude
    - { type: std.SetEnv }
    shell: pytask
    run: hdl_if.dfm.gen_from.GenFromSv
    with:
      pkgname:
        desc: Name of the SV package; the file is <pkgname>.sv
        type: str
      pymodule:
        desc: Name of the generated Python module (default <pkgname>_api)
        type: str
        value: ""
      include:
        desc: Only use definitions whose pkg::name matches one of these patterns
        type: list
      exclude:
        desc: Skip definitions whose pkg::name matches one of these patterns
        type: list
      sv_fields:
        desc: Which data members become fields, "public" or "rand"
        type: str
        value: ""
      field_exclude:
        desc: Skip fields whose pkg::Class.field matches one of these patterns
        type: list
      skip_base:
        desc: Pass over base classes whose pkg::Class matches, dropping their fields
        type: list
      stop_at:
        desc: Also stop the base-class walk at these pkg::Class patterns
        type: list
      skip_unsupported:
        desc: Skip fields of unsupported types instead of failing
        type: bool
        value: false

